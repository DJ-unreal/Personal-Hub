# Personal Hub — environment template.
# Copy to .env.local (gitignored) or, preferably, generate it with:
#   npm run auth:set -- --master <password> --budget <code> --health <code>
# .env.local is never committed.

# --- Auth / crypto (generated by auth:set; 32-byte hex) ---
# Signs the session cookie.
SESSION_SECRET=
# AES-256-GCM key for at-rest encryption of the protected tier. Rotating this
# makes existing encrypted data unreadable — do not change once data exists.
ENCRYPTION_KEY=

# argon2id hashes (NOT plaintext) of the master password + module passcodes.
MASTER_PASSWORD_HASH=
BUDGET_PASSCODE_HASH=
HEALTH_PASSCODE_HASH=

# --- Data directory (SQLite) ---
# Where hub.db lives. MUST NOT be inside a cloud-synced folder (OneDrive,
# Dropbox, iCloud…): sync clients copy the .db separately from its -wal/-shm
# sidecars, which can leave you with a corrupt or silently empty database,
# and they cannot merge writes from two machines. Defaults to ./data.
# HUB_DATA_DIR=C:/Users/you/AppData/Local/PersonalHub

# --- Outbound email (emailing a health document) ---
# Gmail: create an App Password (Google Account → Security → 2-Step
# Verification → App passwords) and paste it here. Not your normal password.
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcdefghijklmnop
# Defaults below suit Gmail; override for another provider.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=you@gmail.com

# --- Health records ---
# Folder holding your health documents. The files stay here on your own
# disk — the app only reads them, never copies them into the database.
# HEALTH_DOCS_DIR=C:\Users\you\Documents\Health Files

# --- Weather (optional; defaults to Regensburg) ---
# WEATHER_LOCATION=Regensburg
# WEATHER_LATITUDE=49.0134
# WEATHER_LONGITUDE=12.1016

# --- Google Calendar OAuth (optional; enables the Today agenda) ---
# From a Google Cloud OAuth 2.0 Client (type: Web application). Add the
# redirect URI below to the client's "Authorized redirect URIs".
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxx
# Defaults to <origin>/api/calendar/callback if omitted.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/callback
